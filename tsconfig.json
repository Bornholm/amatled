{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "lib": ["DOM", "ES2020"],
    "outDir": "web/dist",
    "rootDir": "web/src"
  },
  "include": ["web/src/**/*.ts"],
  "exclude": ["node_modules"]
}
