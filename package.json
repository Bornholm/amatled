{
  "name": "amatled",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "esbuild web/src/main.ts --bundle --outfile=web/dist/bundle.js --platform=browser --target=chrome90 --minify && esbuild web/src/styles/theme.css --bundle --outfile=web/dist/theme.css --minify",
    "dev": "esbuild web/src/main.ts --bundle --outfile=web/dist/bundle.js --platform=browser --target=chrome90 --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3"
  }
}
